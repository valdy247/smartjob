{
  "expo": {
    "name": "VMV Call",
    "slug": "smart-job",
    "scheme": "smartjob",
    "version": "0.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.valdy247.smartjob",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VMV Call necesita el micrófono para interpretar llamadas de voz en vivo.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "buildNumber": "4"
    },
    "plugins": [
      "@twilio/voice-react-native-sdk",
      "expo-secure-store"
    ],
    "owner": "smart-job",
    "extra": {
      "eas": {
        "projectId": "98b22fe3-9111-42d7-bdab-7ca7208dc257"
      }
    }
  }
}
