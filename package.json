  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.80.0",
    "lucide-react": "0.468.0",
    "next": "16.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ai": "7.0.166",
    "@ai-sdk/gateway": "4.0.139"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3"
  }
}
