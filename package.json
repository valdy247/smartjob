{
  "name": "smartjob",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run bridge:test && npm run i18n:check && npm run i18n:test && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "bridge:test": "node --check services/live-bridge/server.mjs && node --test services/live-bridge/*.test.mjs",
    "ios:internal": "cd apps/ios && npx eas-cli build --platform ios --profile preview",
    "catalog:sync": "node scripts/sync-registration-data.mjs",
    "prebuild": "npm run catalog:sync",
    "predev": "npm run catalog:sync",
    "i18n:test": "node --test scripts/interface-language.test.cjs",
    "i18n:coverage": "node scripts/check-visible-i18n.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.80.0",
    "lucide-react": "0.468.0",
    "next": "16.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ai": "7.0.166",
    "@ai-sdk/gateway": "4.0.139",
    "@puckeditor/core": "0.24.0"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3"
  }
}
