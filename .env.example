# Supabase publishable credentials (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only AI keys. Configure in Vercel -> Project -> Environment Variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ES=
ELEVENLABS_VOICE_EN=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Future phone bridge: not active in web-only MVP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
MEDIA_BRIDGE_WSS_URL=

# AI Gateway can authenticate automatically with Vercel OIDC; optional local API key:
AI_GATEWAY_API_KEY=
